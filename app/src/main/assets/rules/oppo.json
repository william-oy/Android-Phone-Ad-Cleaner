  "notes": "ColorOS 16 叫「隐私」，17 起叫「隐私与安全」；realme 上 ro.build.version.opporom 为空属正常。一加/realme 入口名可能不同，引擎多入口兜底。",
  "sections": [
    {
      "id": "oaid_tracking",
      "name": "系统：广告跟踪（OAID）",
      "description": "逐 App 关闭广告跟踪；无总开关，新装 App 默认开",
      "guidePath": "设置 → 隐私（/隐私与安全）→ 设备标识与广告 → 广告跟踪",
      "steps": [
        {"action": "openSettings", "intent": {"action": "android.settings.SETTINGS"}},
        {"action": "tap", "texts": ["隐私与安全", "隐私"]},
        {"action": "goInto", "text": "设备标识与广告", "scrolls": 3},
        {"action": "goInto", "text": "广告跟踪"},
        {"action": "switchOff", "targets": [], "scrolls": 8},
        {"action": "readBack", "targets": []}
      ],
      "targets": [],
      "requiresAdb": false,
      "pitfalls": [
        "没有总开关，每个 App 一个，数量可能上百，要翻 5 屏",
        "ColorOS 17 入口是「隐私与安全」不是「隐私」",
        "部分机型点搜索结果「设备标识与广告」不跳转，走面板路径"
      ]
    },
    {
      "id": "app_store",
      "name": "软件商店",
      "description": "关闭服务管理推广位、个性化推荐；保留下载更新、应用安全",
      "guidePath": "软件商店 → 我的 → 右上齿轮（或 oppo.intent.action.APP_SETTINGS 直达）",
      "steps": [
        {"action": "launchApp", "intent": {"action": "oppo.intent.action.APP_SETTINGS"}},
        {"action": "goInto", "text": "服务管理"},
        {"action": "switchOff", "targets": ["首页悬浮活动图标", "首页活动弹窗", "首页顶部轮播卡片", "底部活动专区", "游戏专区", "游戏详情页活动卡片", "签到", "福利", "活动", "推广", "轮播", "弹窗"], "protectedKeywords": ["帮助与客服", "应用安全", "应用工具", "存储空间清理", "我的资产", "安全守护", "小i客服", "应用使用记录", "首页AI搜索", "自动检测风险应用", "下载更新"], "scrolls": 6},
        {"action": "back"},
        {"action": "goInto", "texts": ["隐私", "账号与隐私"]},
        {"action": "goInto", "texts": ["个性化推荐", "个性化推荐设置", "隐私授权管理"]},
        {"action": "switchOff", "targets": ["个性化推荐"]},
        {"action": "readBack", "targets": ["个性化推荐"]}
      ],
      "targets": ["个性化推荐", "活动", "推广", "轮播", "弹窗", "签到", "福利"],
      "protectedKeywords": ["帮助与客服", "应用安全", "应用工具", "存储空间清理", "下载更新", "安全守护"],
      "requiresAdb": false,
      "pitfalls": [
        "「我的」页有头像和手机号，自动化不截该页",
        "服务管理全关后「开机必备」弹窗仍会出现",
        "一加/realme 商店没有「服务管理」子页，个性化推荐在「账号与隐私 → 隐私授权管理」"
      ]
    },
    {
