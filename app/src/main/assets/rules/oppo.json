        {"action": "goInto", "text": "隐私"},
        {"action": "goInto", "text": "广告管理"},
        {"action": "switchOff", "targets": ["开屏广告", "资讯列表广告"], "protectedKeywords": ["摇一摇广告"]},
        {"action": "back"},
        {"action": "goInto", "texts": ["个性化管理", "个性化"]},
        {"action": "switchOff", "targets": ["个性化推荐", "个性化广告推荐", "个性化搜索推荐", "个性化优惠推荐"]},
        {"action": "readBack", "targets": ["个性化推荐"]}
