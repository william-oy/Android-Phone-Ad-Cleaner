  "pitfalls": [
    {"title": "摇一摇广告点不动", "desc": "浏览器/商店「摇一摇广告」在上级开关关掉后仍显示开且 enabled=false，系统置灰，点不动属正常，不算独立关闭。", "severity": "warn"},
    {"title": "com.oplus.appdetail 不能挂", "desc": "挂起它会导致所有第三方安装永久卡在「正在安装」，卸载也一样。已被别的工具挂的要用 unsuspend 还原。", "severity": "danger"},
    {"title": "负一屏设置 adb 起不来", "desc": "负一屏设置页受 OPPO_COMPONENT_SAFE 私有权限保护，adb/am start 都被拒，只能手动：桌面左滑→左上头像→设置。", "severity": "warn"},
    {"title": "「设置,有1条新通知」", "desc": "主题/游戏中心设置入口带通知角标，文字是「设置,有1条新通知」，精确匹配找不到，要按包含匹配。", "severity": "info"},
    {"title": "ColorOS 版本入口名变", "desc": "16 叫「隐私」，17 叫「隐私与安全」；realme 上 opporom 字段为空属正常。", "severity": "info"}
  ]
