        {"action": "back"},
        {"action": "back"},
        {"action": "goInto", "text": "隐私"},
        {"action": "goInto", "texts": ["个性化推荐设置", "个性化推荐"]},
        {"action": "switchOff", "targets": ["个性化推荐"]},
        {"action": "confirm"},
        {"action": "readBack", "targets": ["开屏广告", "个性化推荐"]}
