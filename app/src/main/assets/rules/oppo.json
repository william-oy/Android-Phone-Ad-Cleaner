        {"action": "goInto", "text": "功能管理"},
        {"action": "switchOff", "targets": ["搜索框提示词"]},
        {"action": "back"},
        {"action": "goInto", "texts": ["账号与隐私", "隐私"]},
        {"action": "goInto", "text": "隐私"},
        {"action": "switchOff", "targets": ["个性化推荐"]},
        {"action": "readBack", "targets": ["搜索框提示词", "个性化推荐"]}
      ],
      "targets": ["榜单", "小说", "购物", "个性化推荐", "精选资讯", "未下载应用推荐", "探索发现", "活动皮肤", "推荐卡片", "热搜榜单", "搜索框提示词"],
      "protectedKeywords": ["APP内搜索", "搜索建议", "便捷服务", "应用建议", "本机资产推荐"],
      "requiresAdb": false,
      "pitfalls": [
        "SearchSettingActivity 未导出，am start -n 会被拒，必须用 scheme gs://search/setting",
        "com.heytap.quicksearchbox 被挂起时 scheme 会落到「应用已被暂停」页，运行前不能挂它",
        "「APP内搜索」必须开着，关了搜不到本机应用",
        "搜索页顶部会提示「搜索结果受限」，不要点「去开启」"
      ]
    },
