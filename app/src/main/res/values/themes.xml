<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AdCleaner" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- M3 角色色 -->
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_onPrimary</item>
        <item name="colorPrimaryContainer">@color/m3_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/m3_onPrimaryContainer</item>
        <item name="colorSecondary">@color/m3_secondary</item>
        <item name="colorOnSecondary">@color/m3_onSecondary</item>
        <item name="colorSecondaryContainer">@color/m3_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/m3_onSecondaryContainer</item>
        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorOnTertiary">@color/m3_onTertiary</item>
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_onError</item>
        <item name="colorErrorContainer">@color/m3_errorContainer</item>
        <item name="colorOnErrorContainer">@color/m3_onErrorContainer</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_onSurface</item>
        <item name="colorSurfaceVariant">@color/m3_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/m3_onSurfaceVariant</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outlineVariant</item>

        <!-- 兼容旧引用 -->
        <item name="colorPrimaryVariant">@color/brand_blue_light</item>

        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg_page</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialCardViewElevation">0dp</item>
        <item name="materialCardViewStyle">@style/Widget.AdCleaner.CardView</item>
    </style>

    <style name="Widget.AdCleaner.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.AdCleaner.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
        <item name="backgroundTint">@color/m3_primary</item>
    </style>

    <style name="Widget.AdCleaner.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">14dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
    </style>

    <!-- 图文引导页 Toolbar -->
    <style name="Widget.AdCleaner.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/m3_primary</item>
        <item name="titleTextColor">@color/m3_onPrimary</item>
        <item name="navigationIconTint">@color/m3_onPrimary</item>
    </style>
</resources>
